{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://berliandros-eye.local/schemas/game-observation-v1.json",
  "title": "MPL S18 game transcript observation",
  "description": "Atomic observation extracted from one official per-game VOD transcript. Separate from the 27-source broadcast observation ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "observation_id",
    "match_detail_id",
    "game_no",
    "source_id",
    "video_id",
    "snippet_start",
    "snippet_end",
    "start_s",
    "end_s",
    "quote",
    "quote_sha256",
    "claim",
    "claim_type",
    "topic",
    "entities",
    "confidence",
    "status"
  ],
  "properties": {
    "record_type": { "const": "game_observation" },
    "observation_id": { "type": "string", "pattern": "^GOBS-[0-9]{4}-G[1-3]-[0-9]{3}$" },
    "match_detail_id": { "type": "string", "pattern": "^[0-9]{4}$" },
    "game_no": { "type": "integer", "minimum": 1, "maximum": 3 },
    "source_id": { "type": "string", "pattern": "^src-game-[A-Za-z0-9_-]{11}$" },
    "video_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
    "snippet_start": { "type": "integer", "minimum": 0 },
    "snippet_end": { "type": "integer", "minimum": 0 },
    "start_s": { "type": "number", "minimum": 0 },
    "end_s": { "type": "number", "minimum": 0 },
    "quote": { "type": "string", "minLength": 10 },
    "quote_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "claim": { "type": "string", "minLength": 10 },
    "claim_type": { "enum": ["commentary", "observation", "statistic", "inference"] },
    "topic": { "type": "string", "minLength": 1 },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "players": { "type": "array", "items": { "type": "string" } },
        "teams": { "type": "array", "items": { "type": "string" } },
        "heroes": { "type": "array", "items": { "type": "string" } },
        "maps": { "type": "array", "items": { "type": "string" } },
        "matches": { "type": "array", "items": { "type": "string" } }
      }
    },
    "confidence": { "enum": ["high", "med", "low"] },
    "status": { "enum": ["accepted", "needs_review", "rejected"] },
    "notes": { "type": "string" },
    "created_at": { "type": "string" }
  }
}
